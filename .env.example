# ---- Director / model host (server side, optional) ----
# Set any ONE of these and players can enter the world without pasting a key.
# DIRECTOR_API_KEY works with whatever base URL you point DIRECTOR_BASE_URL at.
DIRECTOR_API_KEY=
DIRECTOR_BASE_URL=https://api.cerebras.ai/v1
DIRECTOR_MODEL=

# Or use a provider-specific variable; the route picks these up automatically.
CEREBRAS_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Optional Tier-2 asset search (Poly Pizza) ----
POLY_PIZZA_KEY=

# ---- Optional CDN for heavy GLB / HDRI assets ----
# e.g. https://assets.yourdomain.com (Cloudflare R2 / S3 + CloudFront)
NEXT_PUBLIC_ASSET_BASE=
