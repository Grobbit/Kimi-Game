# ---- Director / Cerebras (server side, optional) ----
# If set, players can enter the world without pasting a key (the key stays server-side).
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=kimi-k3.1-pro

# ---- Optional Tier-2 asset search (Poly Pizza) ----
POLY_PIZZA_KEY=

# ---- Optional CDN for heavy GLB / HDRI assets ----
# e.g. https://assets.yourdomain.com (Cloudflare R2 / S3 + CloudFront)
NEXT_PUBLIC_ASSET_BASE=
